# Local environment (do not commit)
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.DS_Store
.env
.env.*

# Rebuilt offline — run: python scripts/build_index.py
data/chroma/**
!data/chroma/.gitkeep

# Vendored embedding weights (~90MB) — keep local; do not push
