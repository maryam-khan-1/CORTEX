{
  "models": {
    "fast": "hf.co/entrick/Security-SLM-Gemma-4-E2B-it-GGUF:Q4_K_M",
    "deep": "luisppb16/gemma4-e4b-SecOps:latest",
    "fallback_fast": "gemma4:e2b",
    "fallback_deep": "gemma4:e4b",
    "multimodal": "gemma4:12b"
  },
  "sampling": {
    "extraction": {
      "temperature": 0.2,
      "top_p": 0.95,
      "top_k": 64
    },
    "consensus": {
      "temperature": 0.3,
      "top_p": 0.95,
      "top_k": 64
    },
    "default": {
      "temperature": 1.0,
      "top_p": 0.95,
      "top_k": 64
    }
  },
  "harness": {
    "max_retries": 2,
    "constrain_json": true
  },
  "performance": {
    "num_ctx_fast": 3072,
    "num_ctx_deep": 6144,
    "num_predict_fast": 96,
    "num_predict_deep": 384,
    "keep_alive": "60m",
    "warmup": false,
    "prewarm_on_start": true,
    "think": false
  },
  "cache": {
    "enabled": true,
    "max_entries": 2000
  },
  "rag": {
    "collection": "cortex_cve",
    "persist_dir": "data/chroma",
    "embedding_model": "data/models/all-MiniLM-L6-v2",
    "top_k": 3,
    "offline": true
  },
  "triage": {
    "consensus_n": 3,
    "early_exit": true,
    "batch": true,
    "batch_min": 3,
    "batch_size": 8,
    "max_workers": 3,
    "max_deep": 3
  },
  "agent": {
    "max_steps": 8,
    "max_revisions": 1,
    "self_critique": true,
    "rag_top_k": 4,
    "num_predict": 384,
    "num_predict_terse": 256,
    "alert_max_steps": 3,
    "default_target": "data/vulnerable_code.py",
    "default_goal": "Autonomous defend: audit data/vulnerable_code.py. Call get_code_context once. Report CWE findings from the code (SQL injection, command injection, unsafe pickle, etc.) — code findings do not need CVE ids or grounded_on. Only search_cve/lookup_kev if citing a specific CVE you retrieved. Then return ONLY Report JSON. Keep explanations short."
  },
  "autonomy": {
    "interval_s": 2.0,
    "consensus_n": 2,
    "escalate_labels": ["critical", "suspicious", "unknown"],
    "investigate_labels": ["critical", "unknown"],
    "max_incidents": 30
  },
  "demo": {
    "log_limit": 3,
    "consensus_n": 1,
    "cve_query": "CVE-2025-24813 Apache Tomcat",
    "fake_cve_query": "CVE-2099-00001 toaster firmware quantum kyber",
    "agent_goal": "Autonomous defend: audit data/vulnerable_code.py. Call get_code_context once. Report CWE findings from the code without inventing CVEs. Return ONLY Report JSON. Keep explanations short."
  }
}
